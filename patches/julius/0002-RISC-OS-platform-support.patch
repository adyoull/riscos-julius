diff --git a/src/platform/riscos/riscos.c b/src/platform/riscos/riscos.c
new file mode 100644
index 0000000..a3b2d7f
--- /dev/null
+++ b/src/platform/riscos/riscos.c
@@ -0,0 +1,118 @@
+#ifdef __riscos__
+
+#include "platform/riscos/riscos.h"
+
+#include "SDL.h"
+
+#include <kernel.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define Wimp_ReportError 0x400df
+
+#define DEFAULT_FPS 50
+#define FILENAME_MAX_LENGTH 300
+#define STATS_INTERVAL_MS 10000
+
+/* UnixLib: the C heap goes in a dynamic area with this name, not the WimpSlot. */
+const char *const __dynamic_da_name = "Julius Heap";
+
+static struct {
+    int frame_ms;
+    Uint32 last_frame;
+    char filename[FILENAME_MAX_LENGTH];
+    int logging;
+    Uint32 stats_start;
+    Uint32 frames;
+    Uint32 busy_ms;
+    Uint32 slowest_ms;
+} data;
+
+void riscos_init_output(void)
+{
+    const char *log = getenv("Julius$Log");
+    data.logging = log && *log;
+    const char *target = data.logging ? log : "/dev/null";
+    /* A file can only be open for writing once on RISC OS: open it once, share it. */
+    if (freopen(target, "w", stderr)) {
+        setvbuf(stderr, NULL, _IOLBF, 0);
+        dup2(fileno(stderr), fileno(stdout));
+    }
+}
+
+const char *riscos_data_directory(void)
+{
+    const char *dir = getenv("Julius$Data");
+    if (dir && *dir) {
+        return "/<Julius$Data>";
+    }
+    return 0;
+}
+
+void riscos_report_error(const char *message)
+{
+    struct {
+        int number;
+        char text[252];
+    } error;
+    _kernel_swi_regs r;
+
+    error.number = 0;
+    strncpy(error.text, message, sizeof(error.text) - 1);
+    error.text[sizeof(error.text) - 1] = 0;
+    r.r[0] = (int) &error;
+    r.r[1] = 1; /* OK box */
+    r.r[2] = (int) "Julius";
+    _kernel_swi(Wimp_ReportError, &r, &r);
+}
+
+const char *riscos_filename(const char *filename)
+{
+    if (!filename || !strchr(filename, ' ')) {
+        return filename;
+    }
+    size_t i;
+    for (i = 0; filename[i] && i < FILENAME_MAX_LENGTH - 1; i++) {
+        data.filename[i] = filename[i] == ' ' ? (char) 0xa0 : filename[i];
+    }
+    data.filename[i] = 0;
+    return data.filename;
+}
+
+/* Called at the start of every main loop pass: the time since the end of the
+ * last wait is what the game spent on events, its tick and drawing. */
+void platform_per_frame_callback(void)
+{
+    Uint32 now = SDL_GetTicks();
+    if (!data.frame_ms) {
+        const char *fps_var = getenv("Julius$FPS");
+        int fps = fps_var && *fps_var ? atoi(fps_var) : DEFAULT_FPS;
+        data.frame_ms = fps > 0 && fps <= 1000 ? 1000 / fps : -1;
+        data.last_frame = data.stats_start = now;
+        SDL_Log("RISC OS: frame limit %d ms (Julius$FPS %s)", data.frame_ms, fps_var ? fps_var : "not set");
+        return;
+    }
+    Uint32 busy = now - data.last_frame;
+    if (data.logging) {
+        data.frames++;
+        data.busy_ms += busy;
+        if (busy > data.slowest_ms) {
+            data.slowest_ms = busy;
+        }
+        if (now - data.stats_start >= STATS_INTERVAL_MS) {
+            SDL_Log("Frames: %.1f fps, %.1f ms work a frame, slowest %u ms",
+                data.frames * 1000.0 / (now - data.stats_start),
+                data.frames ? (double) data.busy_ms / data.frames : 0.0, (unsigned) data.slowest_ms);
+            data.stats_start = now;
+            data.frames = data.busy_ms = data.slowest_ms = 0;
+        }
+    }
+    if (data.frame_ms > 0 && busy < (Uint32) data.frame_ms) {
+        SDL_Delay(data.frame_ms - busy);
+    }
+    data.last_frame = SDL_GetTicks();
+}
+
+#endif // __riscos__
diff --git a/src/platform/riscos/riscos.h b/src/platform/riscos/riscos.h
new file mode 100644
index 0000000..abe843c
--- /dev/null
+++ b/src/platform/riscos/riscos.h
@@ -0,0 +1,32 @@
+#ifndef PLATFORM_RISCOS_H
+#define PLATFORM_RISCOS_H
+
+#ifdef __riscos__
+
+/*
+ * RISC OS (RISC OS 5, UnixLib) support.
+ *
+ * - The game draws its own mouse pointer (the SDL driver has no colour
+ *   pointers); SDL hides the desktop pointer while it is over the game.
+ * - Each frame waits for the rest of its time with SDL_Delay, which yields
+ *   to the desktop: there is no vsync to slow the main loop down.
+ */
+#define PLATFORM_USE_SOFTWARE_CURSOR
+
+#define PLATFORM_ENABLE_PER_FRAME_CALLBACK
+void platform_per_frame_callback(void);
+
+/* Sends stdout and stderr to <Julius$Log>, or nowhere: nothing may print in the desktop. */
+void riscos_init_output(void);
+
+/* The data folder from Julius$Data ("/<Julius$Data>", expanded by UnixLib), or 0. */
+const char *riscos_data_directory(void);
+
+/* Shows a desktop error box (Wimp_ReportError). */
+void riscos_report_error(const char *message);
+
+/* File names with spaces ("North African.sg2"): RISC OS uses hard spaces. */
+const char *riscos_filename(const char *filename);
+
+#endif // __riscos__
+#endif // PLATFORM_RISCOS_H
