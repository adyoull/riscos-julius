diff --git a/src/platform/riscos/riscos_present.c b/src/platform/riscos/riscos_present.c
new file mode 100644
index 00000000..a65db67d
--- /dev/null
+++ b/src/platform/riscos/riscos_present.c
@@ -0,0 +1,344 @@
+#include "platform/riscos/riscos_present.h"
+
+#ifdef PLATFORM_RISCOS_PRESENT
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CELL_W 64
+#define CELL_H 16
+#define MAX_UPDATE_RECTS 64
+#define STATS_INTERVAL_MS 10000
+
+typedef struct {
+    int x0, y0, x1, y1; /* canvas coordinates, x1/y1 exclusive */
+} cell_rect;
+
+static struct {
+    color_t *shadow;      /* the last frame presented */
+    int sw, sh;           /* canvas size */
+    SDL_Surface *surface; /* the window surface it was presented to */
+    int dw, dh;           /* surface size */
+    Uint32 format;
+    int direct;           /* 32-bit RGB in either order: drawn here */
+    int swap;             /* red and blue swapped (XBGR, the usual RISC OS order) */
+    int *xmap, *ymap;     /* surface x/y -> canvas x/y */
+    int *xstart, *ystart; /* canvas x/y -> first surface x/y showing it */
+    uint32_t *rowbuf;
+    unsigned char *dirty;
+    int cols, bands;
+    cell_rect *rects;
+    int max_rects;
+    int *open, *next;     /* rect indices reaching the band above / this band */
+    int full;
+    /* statistics for the log */
+    Uint32 stats_start;
+    unsigned frames, full_frames, cells, pixels;
+    Uint64 ticks;
+} p = { .full = 1 };
+
+void riscos_present_reset(void)
+{
+    p.full = 1;
+}
+
+static void free_maps(void)
+{
+    free(p.shadow); free(p.xmap); free(p.ymap); free(p.xstart); free(p.ystart);
+    free(p.rowbuf); free(p.dirty); free(p.rects); free(p.open); free(p.next);
+    p.shadow = 0; p.xmap = p.ymap = p.xstart = p.ystart = 0;
+    p.rowbuf = 0; p.dirty = 0; p.rects = 0; p.open = p.next = 0;
+}
+
+/* Nearest-neighbour map from n_dst positions onto n_src, and its inverse
+ * (start[s] = first destination showing source s; start[n_src] = n_dst). */
+static void make_map(int *map, int *start, int n_src, int n_dst)
+{
+    int s = 0;
+    for (int d = 0; d < n_dst; d++) {
+        map[d] = (int) ((int64_t) d * n_src / n_dst);
+        while (s <= map[d]) {
+            start[s++] = d;
+        }
+    }
+    while (s <= n_src) {
+        start[s++] = n_dst;
+    }
+}
+
+static int setup(SDL_Surface *surface, int sw, int sh)
+{
+    free_maps();
+    p.sw = sw;
+    p.sh = sh;
+    p.dw = surface->w;
+    p.dh = surface->h;
+    p.surface = surface;
+    p.format = surface->format->format;
+    /* Formats drawn directly (SDL counts XRGB8888 as 24 bits per pixel). */
+    p.swap = p.format == SDL_PIXELFORMAT_XBGR8888 || p.format == SDL_PIXELFORMAT_ABGR8888;
+    p.direct = p.swap || p.format == SDL_PIXELFORMAT_XRGB8888 || p.format == SDL_PIXELFORMAT_ARGB8888;
+#ifndef __riscos__
+    if (getenv("RISCOS_PRESENT_SWAP")) {
+        p.swap = 1; /* host test: draw as for an XBGR screen */
+    }
+#endif
+    p.cols = (sw + CELL_W - 1) / CELL_W;
+    p.bands = (sh + CELL_H - 1) / CELL_H;
+    p.max_rects = p.cols * p.bands;
+    p.shadow = malloc((size_t) sw * sh * sizeof(color_t));
+    p.xmap = malloc(sizeof(int) * p.dw);
+    p.ymap = malloc(sizeof(int) * p.dh);
+    p.xstart = malloc(sizeof(int) * (sw + 1));
+    p.ystart = malloc(sizeof(int) * (sh + 1));
+    p.rowbuf = malloc(sizeof(uint32_t) * p.dw);
+    p.dirty = malloc((size_t) p.cols * p.bands);
+    p.rects = malloc(sizeof(cell_rect) * p.max_rects);
+    p.open = malloc(sizeof(int) * p.cols);
+    p.next = malloc(sizeof(int) * p.cols);
+    if (!p.shadow || !p.xmap || !p.ymap || !p.xstart || !p.ystart || !p.rowbuf || !p.dirty || !p.rects ||
+        !p.open || !p.next) {
+        free_maps();
+        p.surface = 0;
+        return 0;
+    }
+    make_map(p.xmap, p.xstart, sw, p.dw);
+    make_map(p.ymap, p.ystart, sh, p.dh);
+    p.full = 1;
+    SDL_Log("RISC OS presenter: %d x %d shown in %d x %d (%s, %s)", sw, sh, p.dw, p.dh,
+        SDL_GetPixelFormatName(p.format), p.direct ? (p.swap ? "drawn, red and blue swapped" : "drawn") : "by SDL");
+    return 1;
+}
+
+/* Compares the canvas with the last frame; copies what changed into the
+ * shadow and marks those cells. Returns the number of dirty cells. */
+static int find_changes(const color_t *canvas)
+{
+    int count = 0;
+    if (p.full) {
+        memcpy(p.shadow, canvas, (size_t) p.sw * p.sh * sizeof(color_t));
+        memset(p.dirty, 1, (size_t) p.cols * p.bands);
+        return p.cols * p.bands;
+    }
+    for (int b = 0; b < p.bands; b++) {
+        int y0 = b * CELL_H;
+        int y1 = y0 + CELL_H > p.sh ? p.sh : y0 + CELL_H;
+        unsigned char *dirty = &p.dirty[b * p.cols];
+        for (int c = 0; c < p.cols; c++) {
+            int x0 = c * CELL_W;
+            size_t bytes = (size_t) ((x0 + CELL_W > p.sw ? p.sw : x0 + CELL_W) - x0) * sizeof(color_t);
+            dirty[c] = 0;
+            for (int y = y0; y < y1; y++) {
+                size_t offset = (size_t) y * p.sw + x0;
+                if (memcmp(&canvas[offset], &p.shadow[offset], bytes) != 0) {
+                    for (; y < y1; y++) {
+                        offset = (size_t) y * p.sw + x0;
+                        memcpy(&p.shadow[offset], &canvas[offset], bytes);
+                    }
+                    dirty[c] = 1;
+                    count++;
+                    break;
+                }
+            }
+        }
+    }
+    return count;
+}
+
+/* Runs of dirty cells in each band; a run spanning the same columns as a
+ * rectangle that reached the band above extends that rectangle down. */
+static int collect_rects(void)
+{
+    int n = 0;
+    int open_count = 0, next_count = 0;
+    int *open = p.open, *next = p.next;
+    for (int b = 0; b < p.bands; b++) {
+        int y0 = b * CELL_H;
+        int y1 = y0 + CELL_H > p.sh ? p.sh : y0 + CELL_H;
+        const unsigned char *dirty = &p.dirty[b * p.cols];
+        next_count = 0;
+        for (int c = 0; c < p.cols;) {
+            if (!dirty[c]) {
+                c++;
+                continue;
+            }
+            int c0 = c;
+            while (c < p.cols && dirty[c]) {
+                c++;
+            }
+            int x0 = c0 * CELL_W;
+            int x1 = c * CELL_W > p.sw ? p.sw : c * CELL_W;
+            int index = -1;
+            for (int i = 0; i < open_count; i++) {
+                cell_rect *r = &p.rects[open[i]];
+                if (r->x0 == x0 && r->x1 == x1 && r->y1 == y0) {
+                    r->y1 = y1;
+                    index = open[i];
+                    break;
+                }
+            }
+            if (index < 0) {
+                index = n++;
+                p.rects[index].x0 = x0;
+                p.rects[index].x1 = x1;
+                p.rects[index].y0 = y0;
+                p.rects[index].y1 = y1;
+            }
+            next[next_count++] = index;
+        }
+        int *t = open;
+        open = next;
+        next = t;
+        open_count = next_count;
+    }
+    return n;
+}
+
+static inline uint32_t to_xbgr(color_t c)
+{
+    return __builtin_bswap32(c << 8);
+}
+
+/* Scales and converts the canvas rectangle into the surface. Returns the
+ * surface rectangle drawn. */
+static SDL_Rect draw_rect(const cell_rect *r)
+{
+    SDL_Rect out;
+    int dx0 = p.xstart[r->x0], dx1 = p.xstart[r->x1];
+    int dy0 = p.ystart[r->y0], dy1 = p.ystart[r->y1];
+    out.x = dx0;
+    out.y = dy0;
+    out.w = dx1 - dx0;
+    out.h = dy1 - dy0;
+    if (out.w <= 0 || out.h <= 0) {
+        out.w = out.h = 0;
+        return out;
+    }
+    int swap = p.swap;
+    uint8_t *pixels = (uint8_t *) p.surface->pixels;
+    int pitch = p.surface->pitch;
+    int last_sy = -1;
+    for (int dy = dy0; dy < dy1; dy++) {
+        int sy = p.ymap[dy];
+        if (sy != last_sy) {
+            const color_t *src = &p.shadow[(size_t) sy * p.sw];
+            uint32_t *buf = p.rowbuf;
+            if (swap) {
+                for (int dx = dx0; dx < dx1; dx++) {
+                    *buf++ = to_xbgr(src[p.xmap[dx]]);
+                }
+            } else {
+                for (int dx = dx0; dx < dx1; dx++) {
+                    *buf++ = src[p.xmap[dx]];
+                }
+            }
+            last_sy = sy;
+        }
+        memcpy(pixels + (size_t) dy * pitch + (size_t) dx0 * 4, p.rowbuf, (size_t) out.w * 4);
+    }
+    p.pixels += (unsigned) (out.w * out.h);
+    return out;
+}
+
+/* Surfaces in other formats (16 or 8 bits per pixel desktops): SDL does it. */
+static void present_generic(SDL_Window *window, SDL_Surface *surface, const color_t *canvas)
+{
+    SDL_Surface *src = SDL_CreateRGBSurfaceWithFormatFrom((void *) canvas, p.sw, p.sh, 32,
+        p.sw * (int) sizeof(color_t), SDL_PIXELFORMAT_ARGB8888);
+    if (src) {
+        /* The canvas's alpha isn't set: copy, don't blend. */
+        SDL_SetSurfaceBlendMode(src, SDL_BLENDMODE_NONE);
+        SDL_BlitScaled(src, NULL, surface, NULL);
+        SDL_FreeSurface(src);
+        SDL_UpdateWindowSurface(window);
+    }
+}
+
+void riscos_present_frame(SDL_Window *window, const color_t *canvas, int canvas_w, int canvas_h)
+{
+    Uint64 start = SDL_GetPerformanceCounter();
+    SDL_Surface *surface = SDL_GetWindowSurface(window);
+    if (!surface || !canvas) {
+        return;
+    }
+    if (surface != p.surface || surface->w != p.dw || surface->h != p.dh ||
+        surface->format->format != p.format || canvas_w != p.sw || canvas_h != p.sh || !p.shadow) {
+        if (!setup(surface, canvas_w, canvas_h)) {
+            return;
+        }
+    }
+    if (!p.direct) {
+        present_generic(window, surface, canvas);
+        return;
+    }
+#ifndef __riscos__
+    if (getenv("RISCOS_PRESENT_FULL")) {
+        p.full = 1; /* host test: present every frame in full */
+    }
+#endif
+    int was_full = p.full;
+    int cells = find_changes(canvas);
+    p.full = 0;
+    if (cells) {
+        int n = collect_rects();
+        SDL_Rect update[MAX_UPDATE_RECTS];
+        SDL_Rect bounds = { 0, 0, 0, 0 };
+        int x0 = p.dw, y0 = p.dh, x1 = 0, y1 = 0;
+        int count = 0;
+        for (int i = 0; i < n; i++) {
+            SDL_Rect r = draw_rect(&p.rects[i]);
+            if (!r.w) {
+                continue;
+            }
+            if (count < MAX_UPDATE_RECTS) {
+                update[count] = r;
+            }
+            count++;
+            if (r.x < x0) x0 = r.x;
+            if (r.y < y0) y0 = r.y;
+            if (r.x + r.w > x1) x1 = r.x + r.w;
+            if (r.y + r.h > y1) y1 = r.y + r.h;
+        }
+        if (count > MAX_UPDATE_RECTS) {
+            bounds.x = x0;
+            bounds.y = y0;
+            bounds.w = x1 - x0;
+            bounds.h = y1 - y0;
+            SDL_UpdateWindowSurfaceRects(window, &bounds, 1);
+        } else if (count) {
+            SDL_UpdateWindowSurfaceRects(window, update, count);
+        }
+    }
+
+    /* Statistics, logged every 10 seconds. */
+    Uint32 now = SDL_GetTicks();
+    if (!p.stats_start) {
+        p.stats_start = now;
+    }
+    p.frames++;
+    p.full_frames += was_full;
+    p.cells += (unsigned) cells;
+    p.ticks += SDL_GetPerformanceCounter() - start;
+    if (now - p.stats_start >= STATS_INTERVAL_MS && p.frames) {
+        SDL_Log("Present: %u frames (%u full), %.1f%% of cells changed, %u pixels drawn a frame, %.2f ms a frame",
+            p.frames, p.full_frames, 100.0 * p.cells / ((double) p.frames * p.cols * p.bands),
+            p.pixels / p.frames, p.ticks * 1000.0 / SDL_GetPerformanceFrequency() / p.frames);
+        p.stats_start = now;
+        p.frames = p.full_frames = p.cells = p.pixels = 0;
+        p.ticks = 0;
+    }
+}
+
+void riscos_present_window_to_canvas(int *x, int *y)
+{
+    if (!p.xmap) {
+        return;
+    }
+    if (*x < 0) *x = 0;
+    if (*y < 0) *y = 0;
+    *x = *x < p.dw ? p.xmap[*x] : p.sw - 1;
+    *y = *y < p.dh ? p.ymap[*y] : p.sh - 1;
+}
+
+#endif // PLATFORM_RISCOS_PRESENT
diff --git a/src/platform/riscos/riscos_present.h b/src/platform/riscos/riscos_present.h
new file mode 100644
index 00000000..a36ee37a
--- /dev/null
+++ b/src/platform/riscos/riscos_present.h
@@ -0,0 +1,37 @@
+#ifndef PLATFORM_RISCOS_PRESENT_H
+#define PLATFORM_RISCOS_PRESENT_H
+
+/*
+ * RISC OS presenter: puts the game's canvas (ARGB8888, logical size) in the
+ * SDL window surface, scaled to the window, without an SDL renderer.
+ *
+ * SDL's software renderer converts and scales the whole frame every frame,
+ * and with a scale that isn't a whole number (Julius's 150%) and the RISC OS
+ * screen's XBGR order it takes SDL's slowest path: about 75 ms a frame on a
+ * Pi 4 at 1920 x 1200. This keeps a copy of the last frame presented and
+ * only converts, scales and plots the 64 x 16 pixel cells that changed.
+ *
+ * Built on RISC OS, or anywhere with -DPLATFORM_RISCOS_PRESENT (for testing).
+ */
+
+#if defined(__riscos__) && !defined(PLATFORM_RISCOS_PRESENT)
+#define PLATFORM_RISCOS_PRESENT
+#endif
+
+#ifdef PLATFORM_RISCOS_PRESENT
+
+#include "graphics/color.h"
+
+#include "SDL.h"
+
+/* Presents canvas (canvas_w x canvas_h). */
+void riscos_present_frame(SDL_Window *window, const color_t *canvas, int canvas_w, int canvas_h);
+
+/* Forgets the last frame: the next one is presented in full. */
+void riscos_present_reset(void);
+
+/* Window (SDL) coordinates to canvas coordinates. */
+void riscos_present_window_to_canvas(int *x, int *y);
+
+#endif // PLATFORM_RISCOS_PRESENT
+#endif // PLATFORM_RISCOS_PRESENT_H
