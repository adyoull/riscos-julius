+#ifdef PLATFORM_RISCOS_PRESENT
+static struct {
+    color_t *pixels[CURSOR_MAX];
+    int size[CURSOR_MAX];
+    color_t *backup;
+    int backup_size;
+} riscos_cursor;
+
+static int blend_channel(color_t c, color_t b, unsigned a, int shift)
+{
+    return (int) ((((c >> shift) & 0xff) * a + ((b >> shift) & 0xff) * (255 - a)) / 255);
+}
+
+/* Blends the game's pointer into the canvas, keeping what was under it in
+ * *saved (x, y, w, h): the presenter then sees it as a change, and the
+ * canvas is put back afterwards, so the game never sees the pointer. */
+static int riscos_cursor_draw(SDL_Rect *saved)
+{
+    const mouse *m = mouse_get();
+    int id = platform_cursor_get_current_shape();
+    if (m->is_touch || !m->is_inside_window || !riscos_cursor.pixels[id] || !framebuffer) {
+        return 0;
+    }
+    const cursor *c = input_cursor_data(id, platform_cursor_get_current_scale());
+    if (!c) {
+        return 0;
+    }
