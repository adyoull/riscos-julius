From 4f4b5a12480a04aa7f04fae55bc7682add148388 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 18 Oct 2026 13:03:14 +0100
Subject: [PATCH 4/4] RISC OS: faster frame comparison (words, NEON)

riscos2test on a Pi 4 at 1920 x 1200: about 14 ms a frame presenting
while only 1-4% of the picture changed, so the time went in comparing
the frame with the last one, not in drawing. UnixLib's memcmp compares a
byte at a time (two byte loads per byte: 18 million loads a frame).

- The canvas is now compared row by row, in memory order, 8 pixels at a
  time, skipping cells already found changed; changed cells are copied
  into the shadow afterwards.
- On processors with NEON (SDL_HasNEON(), which asks VFPSupport on
  RISC OS) riscos_present_neon.c compares 16 pixels per step with
  vld1.32 loads (4-byte aligned: no alignment faults). Only that file is
  built with -mfpu=neon; machines without NEON use the word loop.
- The log's presenter line says which comparison is used.
---
 CMakeLists.txt                            |  4 ++
 src/platform/riscos/riscos_present.c      | 85 ++++++++++++++++++-----
 src/platform/riscos/riscos_present.h      |  4 ++
 src/platform/riscos/riscos_present_neon.c | 35 ++++++++++
 4 files changed, 111 insertions(+), 17 deletions(-)
 create mode 100644 src/platform/riscos/riscos_present_neon.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6f20952..fca30f54 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -229,7 +229,11 @@ elseif (RISCOS)
         ${PLATFORM_FILES}
         ${PROJECT_SOURCE_DIR}/src/platform/riscos/riscos.c
         ${PROJECT_SOURCE_DIR}/src/platform/riscos/riscos_present.c
+        ${PROJECT_SOURCE_DIR}/src/platform/riscos/riscos_present_neon.c
     )
+    # Only this file uses NEON; it's called only when the processor has it.
+    set_source_files_properties(${PROJECT_SOURCE_DIR}/src/platform/riscos/riscos_present_neon.c
+        PROPERTIES COMPILE_FLAGS "-mfpu=neon")
 elseif (RISCOS_PRESENT_TEST)
     add_definitions(-DPLATFORM_RISCOS_PRESENT -DPLATFORM_USE_SOFTWARE_CURSOR)
     set(PLATFORM_FILES
diff --git a/src/platform/riscos/riscos_present.c b/src/platform/riscos/riscos_present.c
index a65db67d..0cb80fe8 100644
--- a/src/platform/riscos/riscos_present.c
+++ b/src/platform/riscos/riscos_present.c
@@ -67,6 +67,31 @@ static void make_map(int *map, int *start, int n_src, int n_dst)
     }
 }
 
+/* True if n pixels differ. Word by word: UnixLib's memcmp compares a byte
+ * at a time, which made the comparison most of the presenting time. */
+static int pixels_differ_words(const color_t *a, const color_t *b, int n)
+{
+    int i = 0;
+    for (; i + 8 <= n; i += 8) {
+        if ((a[i] ^ b[i]) | (a[i + 1] ^ b[i + 1]) | (a[i + 2] ^ b[i + 2]) | (a[i + 3] ^ b[i + 3]) |
+            (a[i + 4] ^ b[i + 4]) | (a[i + 5] ^ b[i + 5]) | (a[i + 6] ^ b[i + 6]) | (a[i + 7] ^ b[i + 7])) {
+            return 1;
+        }
+    }
+    for (; i < n; i++) {
+        if (a[i] != b[i]) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+#ifdef __arm__
+#define HAVE_NEON_COMPARE
+#endif
+
+static int (*pixels_differ)(const color_t *a, const color_t *b, int n) = pixels_differ_words;
+
 static int setup(SDL_Surface *surface, int sw, int sh)
 {
     free_maps();
@@ -103,16 +128,21 @@ static int setup(SDL_Surface *surface, int sw, int sh)
         p.surface = 0;
         return 0;
     }
+#ifdef HAVE_NEON_COMPARE
+    pixels_differ = SDL_HasNEON() ? riscos_present_pixels_differ_neon : pixels_differ_words;
+#endif
     make_map(p.xmap, p.xstart, sw, p.dw);
     make_map(p.ymap, p.ystart, sh, p.dh);
     p.full = 1;
-    SDL_Log("RISC OS presenter: %d x %d shown in %d x %d (%s, %s)", sw, sh, p.dw, p.dh,
-        SDL_GetPixelFormatName(p.format), p.direct ? (p.swap ? "drawn, red and blue swapped" : "drawn") : "by SDL");
+    SDL_Log("RISC OS presenter: %d x %d shown in %d x %d (%s, %s; %s compare)", sw, sh, p.dw, p.dh,
+        SDL_GetPixelFormatName(p.format), p.direct ? (p.swap ? "drawn, red and blue swapped" : "drawn") : "by SDL",
+        pixels_differ == pixels_differ_words ? "word" : "NEON");
     return 1;
 }
 
-/* Compares the canvas with the last frame; copies what changed into the
- * shadow and marks those cells. Returns the number of dirty cells. */
+/* Compares the canvas with the last frame, row by row (memory in order),
+ * skipping cells already found changed; then copies the changed cells into
+ * the shadow. Returns the number of changed cells. */
 static int find_changes(const color_t *canvas)
 {
     int count = 0;
@@ -125,23 +155,44 @@ static int find_changes(const color_t *canvas)
         int y0 = b * CELL_H;
         int y1 = y0 + CELL_H > p.sh ? p.sh : y0 + CELL_H;
         unsigned char *dirty = &p.dirty[b * p.cols];
-        for (int c = 0; c < p.cols; c++) {
-            int x0 = c * CELL_W;
-            size_t bytes = (size_t) ((x0 + CELL_W > p.sw ? p.sw : x0 + CELL_W) - x0) * sizeof(color_t);
-            dirty[c] = 0;
-            for (int y = y0; y < y1; y++) {
-                size_t offset = (size_t) y * p.sw + x0;
-                if (memcmp(&canvas[offset], &p.shadow[offset], bytes) != 0) {
-                    for (; y < y1; y++) {
-                        offset = (size_t) y * p.sw + x0;
-                        memcpy(&p.shadow[offset], &canvas[offset], bytes);
-                    }
+        int band_dirty = 0;
+        memset(dirty, 0, (size_t) p.cols);
+        for (int y = y0; y < y1 && band_dirty < p.cols; y++) {
+            const color_t *crow = &canvas[(size_t) y * p.sw];
+            const color_t *srow = &p.shadow[(size_t) y * p.sw];
+            for (int c = 0; c < p.cols; c++) {
+                if (dirty[c]) {
+                    continue;
+                }
+                int x0 = c * CELL_W;
+                int w = x0 + CELL_W > p.sw ? p.sw - x0 : CELL_W;
+                if (pixels_differ(&crow[x0], &srow[x0], w)) {
                     dirty[c] = 1;
-                    count++;
-                    break;
+                    band_dirty++;
                 }
             }
         }
+        if (!band_dirty) {
+            continue;
+        }
+        count += band_dirty;
+        for (int c = 0; c < p.cols;) {
+            if (!dirty[c]) {
+                c++;
+                continue;
+            }
+            int c0 = c;
+            while (c < p.cols && dirty[c]) {
+                c++;
+            }
+            int x0 = c0 * CELL_W;
+            int x1 = c * CELL_W > p.sw ? p.sw : c * CELL_W;
+            size_t bytes = (size_t) (x1 - x0) * sizeof(color_t);
+            for (int y = y0; y < y1; y++) {
+                size_t offset = (size_t) y * p.sw + x0;
+                memcpy(&p.shadow[offset], &canvas[offset], bytes);
+            }
+        }
     }
     return count;
 }
