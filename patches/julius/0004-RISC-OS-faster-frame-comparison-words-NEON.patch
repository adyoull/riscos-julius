index a36ee37a..cf5e2091 100644
--- a/src/platform/riscos/riscos_present.h
+++ b/src/platform/riscos/riscos_present.h
@@ -30,6 +30,10 @@ void riscos_present_frame(SDL_Window *window, const color_t *canvas, int canvas_
 /* Forgets the last frame: the next one is presented in full. */
 void riscos_present_reset(void);
 
+/* NEON comparison (riscos_present_neon.c, built with -mfpu=neon when the
+ * compiler targets ARM); used only if SDL_HasNEON(). */
+int riscos_present_pixels_differ_neon(const color_t *a, const color_t *b, int n);
+
 /* Window (SDL) coordinates to canvas coordinates. */
 void riscos_present_window_to_canvas(int *x, int *y);
 
diff --git a/src/platform/riscos/riscos_present_neon.c b/src/platform/riscos/riscos_present_neon.c
new file mode 100644
index 00000000..03d9fa63
--- /dev/null
+++ b/src/platform/riscos/riscos_present_neon.c
@@ -0,0 +1,35 @@
+/*
+ * NEON comparison for the RISC OS presenter. This file alone is built with
+ * -mfpu=neon; the presenter only calls it when SDL_HasNEON() says the
+ * processor has NEON (not every VFPv3 machine running RISC OS does).
+ * Loads are vld1.32 on 4-byte aligned pixels: no alignment faults.
+ */
+#include "platform/riscos/riscos_present.h"
+
+#if defined(PLATFORM_RISCOS_PRESENT) && defined(__ARM_NEON)
+
+#include <arm_neon.h>
+
+int riscos_present_pixels_differ_neon(const color_t *a, const color_t *b, int n)
+{
+    int i = 0;
+    for (; i + 16 <= n; i += 16) {
+        uint32x4_t d = veorq_u32(vld1q_u32(a + i), vld1q_u32(b + i));
+        d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 4), vld1q_u32(b + i + 4)));
+        d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 8), vld1q_u32(b + i + 8)));
+        d = vorrq_u32(d, veorq_u32(vld1q_u32(a + i + 12), vld1q_u32(b + i + 12)));
+        uint32x2_t r = vorr_u32(vget_low_u32(d), vget_high_u32(d));
+        r = vpmax_u32(r, r);
+        if (vget_lane_u32(r, 0)) {
+            return 1;
+        }
+    }
+    for (; i < n; i++) {
+        if (a[i] != b[i]) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+#endif
