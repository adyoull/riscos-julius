+
 #include <stdint.h>
 #include <stdlib.h>
 #include <string.h>
@@ -32,6 +36,7 @@ static struct {
     int max_rects;
     int *open, *next;     /* rect indices reaching the band above / this band */
     int full;
+    int log_path;         /* log how SDL shows the picture after this frame */
     /* statistics for the log */
     Uint32 stats_start;
     unsigned frames, full_frames, cells, pixels;
@@ -318,6 +323,7 @@ void riscos_present_frame(SDL_Window *window, const color_t *canvas, int canvas_
         if (!setup(surface, canvas_w, canvas_h)) {
             return;
         }
+        p.log_path = 1;
     }
     if (!p.direct) {
         present_generic(window, surface, canvas);
@@ -362,6 +368,14 @@ void riscos_present_frame(SDL_Window *window, const color_t *canvas, int canvas_
         }
     }
 
+#ifdef __riscos__
+    if (p.log_path) {
+        /* After the first update: EGL's surface shows how it was shown. */
+        riscos_log_display_path(window);
+        p.log_path = 0;
+    }
+#endif
+
     /* Statistics, logged every 10 seconds. */
     Uint32 now = SDL_GetTicks();
     if (!p.stats_start) {
